FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    python3.8-dev \
    python3-pip \
    python-is-python3 \
    build-essential \
    gettext \
    libpq-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libpangocairo-1.0-0 \
    apache2 \
    apache2-utils \
    libapache2-mod-wsgi-py3 \
    ssl-cert \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip certifi

# Apache Konfiguration laden
COPY DockerApp/000-default.conf /etc/apache2/sites-available/000-default.conf
COPY DockerApp/wsgi.conf /etc/apache2/conf-available/wsgi.conf

RUN a2enmod headers ssl && \
    a2ensite 000-default && \
    a2enconf wsgi

# Benutzer und Verzeichnisse anlegen
RUN useradd --create-home -s /bin/bash vagrant && \
    mkdir -p /home/vagrant/media/ /home/vagrant/pyvenv /home/vagrant/static_root/ && \
    chmod -R 755 /home/vagrant

# envdir Verzeichnisse anlegen
RUN mkdir -p /var/envdir/absys && \
    chgrp -R www-data /var/envdir && \
    chmod -R g=rX,o= /var/envdir

# Standardkonfiguration — wird zur Laufzeit via run.sh aus Container-Env-Vars überschrieben
RUN echo 'absys.config.settings.public' > /var/envdir/absys/DJANGO_SETTINGS_MODULE  && \
    echo 'Staging'                       > /var/envdir/absys/DJANGO_CONFIGURATION    && \
    echo '600'                           > /var/envdir/absys/DEFAULT_CONN_MAX_AGE    && \
    echo 'INSECURE'                      > /var/envdir/absys/DJANGO_SECRET_KEY       && \
    echo 'noreply@example.com'           > /var/envdir/absys/DJANGO_DEFAULT_FROM_EMAIL && \
    echo 'INSECURE'                      > /var/envdir/absys/DJANGO_EMAIL_HOST_PASSWORD && \
    echo 'noreply@example.com'           > /var/envdir/absys/DJANGO_EMAIL_HOST_USER  && \
    echo '/home/vagrant/media/'          > /var/envdir/absys/DJANGO_MEDIA_ROOT       && \
    echo '/home/vagrant/static_root/'    > /var/envdir/absys/DJANGO_STATIC_ROOT      && \
    echo 'True'                          > /var/envdir/absys/DJANGO_ABSYS_NUTZE_SOZIALAMTS_BUCHUNGSKENNZEICHEN && \
    echo '555'                           > /var/envdir/absys/DJANGO_ABSYS_SAX_KAPITEL && \
    echo '13'                            > /var/envdir/absys/DJANGO_ABSYS_SAX_MAHNSCHLUESSEL && \
    echo '0'                             > /var/envdir/absys/DJANGO_ABSYS_SAX_ZINSSCHLUESSEL && \
    chgrp -R www-data /var/envdir/absys && \
    chmod -R g=rX,o= /var/envdir/absys

# Startskript laden
COPY DockerApp/run.sh /home/vagrant/run.sh
RUN chmod u+x /home/vagrant/run.sh

# AbSYS aus Quellcode installieren — constraints.pip fixiert kritische Versionen (u.a. WeasyPrint==51)
COPY . /build/
RUN pip3 install /build/ -c /build/requirements/constraints.pip && rm -rf /build/

EXPOSE 443

ENV DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
ENV DEFAULT_DATABASE_URL=postgres://absys:absys@localhost/absys

CMD ["/bin/sh", "-c", "/home/vagrant/run.sh; apache2ctl stop 2>/dev/null; apache2ctl -D FOREGROUND"]
