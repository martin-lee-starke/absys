FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 3.8 is the default python3 in Ubuntu 20.04
    python3 python3-dev python3-pip \
    # Build tools
    build-essential gettext \
    # PostgreSQL client libs
    libpq-dev postgresql-client \
    # lxml
    libxslt1-dev \
    # Pillow
    libtiff5-dev libjpeg-dev zlib1g-dev libfreetype6-dev liblcms2-dev libwebp-dev \
    # WeasyPrint
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf2.0-0 \
    python3-cffi libffi-dev shared-mime-info \
    # wkhtmltopdf + virtual display (for headless PDF rendering)
    wkhtmltopdf xvfb \
    # Utilities
    curl git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps as a cached layer — only invalidated when requirements change.
# Source code is mounted as a volume at runtime, so changes don't require a rebuild.
COPY requirements/ requirements/
COPY setup.py setup.cfg ./
RUN pip3 install --upgrade pip setuptools wheel \
    && pip3 install -c requirements/constraints.pip -r requirements/dev.pip \
    && pip3 install -c requirements/constraints.pip -e .

EXPOSE 8000

CMD ["make", "runserver"]
